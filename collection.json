    {
      "name": "Auth Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var jsonData = pm.response.json();\r\n\r\n// Mengambil token dari data.token sesuai struktur JSON respons server\r\nvar token = jsonData.data.token;\r\n\r\n// Menyimpan ke collection variable dengan nama \"auth_token\"\r\npm.collectionVariables.set(\"auth_token\", token);\r\n\r\nconsole.log(\"Token berhasil disimpan: \" + token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"email\": \"standard_user@example.com\",\r\n  \"password\": \"script_sauce\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
